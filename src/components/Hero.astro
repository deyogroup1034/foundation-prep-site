---
import { Image } from 'astro:assets';
import hero from '@/assets/hero/01-graduation.jpeg';

// The live hero was a 6-slide Slider Revolution module. Per the brief this is
// a static hero using slide 1, with the same static text layers and CTA and
// no transitions. Live values: rgba(0,0,0,.5) scrim over the image; the
// content column sits on a 1240px grid with a 20px left offset.
---

<section class="relative flex min-h-[560px] items-center overflow-hidden lg:min-h-[830px]">
  <Image
    src={hero}
    alt="Foundation Preparatory Academy graduates celebrating at commencement"
    class="absolute inset-0 -z-20 h-full w-full object-cover object-center"
    loading="eager"
    fetchpriority="high"
    widths={[768, 1280, 2048]}
    sizes="100vw"
  />
  <div class="absolute inset-0 -z-10 bg-black/50"></div>

  <div class="mx-auto w-full max-w-[1240px] px-5 pt-[150px] lg:pt-[120px]">
    <h1
      class="max-w-[700px] text-[34px] font-medium leading-[1.22] tracking-[-1px] text-white sm:text-[45px] sm:leading-[55px] sm:tracking-[-2px]"
    >
      Kingdom Character<br />Academic Excellence<br />Generational Impact
    </h1>

    <p
      class="mt-7 flex flex-wrap gap-x-10 gap-y-1 text-[19px] font-medium tracking-[-1px] text-white sm:mt-9 sm:text-[25px] sm:leading-[35px] sm:tracking-[-2px]"
    >
      <span>Grades K-12</span>
      <span>Opened 2014</span>
    </p>

    <a href="/contacts" class="btn-hero mt-9 sm:mt-12">Request Information</a>
  </div>
</section>
