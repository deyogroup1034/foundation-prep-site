---
// The six home-page tile icons, redrawn as inline SVG to replace the theme's
// icon font (icon-schedule, icon-curriculum, icon-book-open, icon-trophy,
// icon-users, icon-accreditation).
export type IconName = 'schedule' | 'curriculum' | 'book-open' | 'trophy' | 'users' | 'accreditation';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}
const { name, size = 52, class: cls = '' } = Astro.props;
const common = { width: size, height: size, viewBox: '0 0 48 48', 'aria-hidden': 'true' };
---

<svg {...common} class={cls} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
  {
    name === 'schedule' && (
      <>
        <circle cx="24" cy="27" r="15" />
        <path d="M24 19v8l5 4" />
        <path d="M13 8 8 13M35 8l5 5M16 42l-3 4M32 42l3 4" />
      </>
    )
  }
  {
    name === 'curriculum' && (
      <>
        <path d="M24 6c-9.9 0-18 7.6-18 17 0 9.4 8.1 17 18 17 2.2 0 4-1.8 4-4 0-1-.4-2-1.1-2.7-.6-.7-1-1.6-1-2.6 0-2.2 1.8-4 4-4h3.1c5 0 9-4 9-9C42 12.7 33.9 6 24 6Z" />
        <circle cx="15" cy="21" r="2.2" fill="currentColor" stroke="none" />
        <circle cx="22" cy="14" r="2.2" fill="currentColor" stroke="none" />
        <circle cx="31" cy="16" r="2.2" fill="currentColor" stroke="none" />
        <circle cx="35" cy="25" r="2.2" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    name === 'book-open' && (
      <>
        <path d="M24 13C20 9.7 15 8 8 8v27c7 0 12 1.7 16 5 4-3.3 9-5 16-5V8c-7 0-12 1.7-16 5Z" />
        <path d="M24 13v27M13 17h5M13 24h5M30 17h5M30 24h5" />
      </>
    )
  }
  {
    name === 'trophy' && (
      <>
        <path d="M15 7h18v11a9 9 0 0 1-18 0V7Z" fill="currentColor" stroke="none" />
        <path d="M15 10h-4a5 5 0 0 0 5 5M33 10h4a5 5 0 0 1-5 5" />
        <path d="M24 27v7M17 41h14l-1.5-7h-11L17 41Z" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    name === 'users' && (
      <>
        <circle cx="18" cy="16" r="6" fill="currentColor" stroke="none" />
        <path d="M7 40v-3c0-5 5-8 11-8s11 3 11 8v3H7Z" fill="currentColor" stroke="none" />
        <circle cx="33" cy="19" r="5" fill="currentColor" stroke="none" />
        <path d="M31 29c5 .4 10 3.2 10 8v3h-9" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    name === 'accreditation' && (
      <>
        <circle cx="24" cy="19" r="12" />
        <circle cx="24" cy="19" r="7" />
        <path d="M17 29 14 44l10-5 10 5-3-15" />
      </>
    )
  }
</svg>
