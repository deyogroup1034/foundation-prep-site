---
import Layout from '@/layouts/Layout.astro';
import SectionTitle from '@/components/SectionTitle.astro';
import LeadForm from '@/components/LeadForm';
import { BIZ, META, telHref } from '@/data/site';

const meta = META.contacts;

// The live page's `maps.google.com/maps?output=embed` iframe (no API key) has
// been retired by Google — it now 404s with X-Frame-Options: SAMEORIGIN, both
// here and on the live WordPress site itself (confirmed 2026-09-03; not a
// regression from the port). OpenStreetMap's own interactive embed
// (openstreetmap.org/export/embed.html) was tried next, but it now requires
// WebGL — and worse, a WebGL context can report as available while the map
// still silently fails to paint any tiles (observed 2026-09-03: context
// created fine, `getContext('webgl')` truthy, marker pin rendered, but the
// actual map tiles never appeared), so client-side feature-detection can't
// reliably guard it. A community static-tile proxy that used to sidestep all
// of this is also DNS-dead.
//
// Rather than depend on any live third-party map service, this renders a
// static mosaic of official OSM raster tiles (tile.openstreetmap.org/z/x/y.png)
// as plain <img> elements — no JS, no WebGL, nothing that can silently fail.
// Verified: a bare <img> of one of these tiles renders correctly in every
// environment tested, including the one where the WebGL embed didn't.
// Attribution (openstreetmap.org/copyright) is required by OSM's tile usage
// policy and is rendered as a small credit line over the mosaic.
const { lat, lon } = BIZ.coords;
const ZOOM = 15;
const TILE = 256;
const COLS = 9; // 2304px wide — covers viewports up to ~2300px
const ROWS = 3; // 768px tall — well over the 520px max panel height
const n = 2 ** ZOOM;
const latRad = (lat * Math.PI) / 180;
const xf = ((lon + 180) / 360) * n;
const yf = ((1 - Math.log(Math.tan(latRad) + 1 / Math.cos(latRad)) / Math.PI) / 2) * n;
const centerTileX = Math.floor(xf);
const centerTileY = Math.floor(yf);
// Sub-tile pixel offset of the exact address within its tile, so the mosaic
// can be shifted to put that exact point at the panel's center rather than
// just snapping to the nearest tile boundary.
const fracX = (xf - centerTileX) * TILE;
const fracY = (yf - centerTileY) * TILE;
const halfCols = Math.floor(COLS / 2);
const halfRows = Math.floor(ROWS / 2);
const targetX = halfCols * TILE + fracX;
const targetY = halfRows * TILE + fracY;
const mosaicTiles = Array.from({ length: ROWS }, (_, row) =>
  Array.from({ length: COLS }, (_, col) => ({
    x: centerTileX + (col - halfCols),
    y: centerTileY + (row - halfRows),
  })),
).flat();

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contacts',
  url: new URL('/contacts', Astro.site ?? Astro.url).href,
};
---

<Layout title={meta.title} description={meta.description} jsonLd={contactSchema}>
  <!-- The live page opens straight onto the map with no title band, which
       left it without an h1. Keep the design and give the page a heading. -->
  <h1 class="sr-only">Contact Foundation Preparatory Academy</h1>

  <!-- Map with the contact card overlaid, as on the live page. The mosaic
       and marker are plain server-rendered <img>/CSS — no client script, no
       failure mode, works with JS disabled. -->
  <section class="relative pt-[150px] lg:pt-[170px]">
    <div class="relative h-[420px] w-full overflow-hidden bg-[#e8eaed] lg:h-[520px]">
      {/* Decorative locator graphic — the real address/phone/email is in the
          contact card below, kept out of aria-hidden. */}
      <div class="absolute inset-0" aria-hidden="true">
        <div
          class="absolute"
          style={`width:${COLS * TILE}px;height:${ROWS * TILE}px;left:calc(50% - ${targetX}px);top:calc(50% - ${targetY}px);`}
        >
          {
            mosaicTiles.map((t, i) => (
              <img
                src={`https://tile.openstreetmap.org/${ZOOM}/${t.x}/${t.y}.png`}
                alt=""
                loading={i < COLS * 2 ? 'eager' : 'lazy'}
                width={TILE}
                height={TILE}
                class="absolute"
                style={`left:${(i % COLS) * TILE}px;top:${Math.floor(i / COLS) * TILE}px;`}
              />
            ))
          }
        </div>

        {/* Marker pin, pinned exactly at the panel's visual center. */}
        <svg
          viewBox="0 0 24 24"
          width="36"
          height="36"
          fill="#169f49"
          stroke="#fff"
          stroke-width="1"
          class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-full drop-shadow-md"
        >
          <path d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z" />
        </svg>
      </div>

      <a
        href="https://www.openstreetmap.org/copyright"
        target="_blank"
        rel="noopener noreferrer"
        class="absolute bottom-1 right-2 bg-white/80 px-1.5 py-0.5 text-[11px] text-[#5d646b] hover:underline"
      >
        © OpenStreetMap contributors
      </a>

      <div class="pointer-events-none absolute inset-0">
        <div class="wrap flex h-full items-center justify-end">
          <div class="pointer-events-auto w-full max-w-[420px] bg-[#59babe] px-8 py-9 text-white">
            <h5 class="text-white">{BIZ.name}</h5>

            <ul class="mt-6 divide-y divide-white/30">
              <li class="flex items-start gap-4 py-4">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" class="mt-[2px] shrink-0">
                  <path d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z"></path>
                </svg>
                <a href={BIZ.mapUrl} target="_blank" rel="noopener noreferrer" class="text-[15px] hover:underline">
                  {BIZ.address.street.replace('St.', 'Street')}, {BIZ.address.city},<br />{BIZ.address.state}
                  {BIZ.address.zip}
                </a>
              </li>
              <li class="flex items-center gap-4 py-4">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" class="shrink-0">
                  <path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.2.4 2.4.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1l-2.3 2.2Z"></path>
                </svg>
                <a href={telHref(BIZ.phone)} class="text-[15px] hover:underline">{BIZ.phone}</a>
              </li>
              <li class="flex items-center gap-4 py-4">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" class="shrink-0">
                  <path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 4-8 5-8-5V6l8 5 8-5v2Z"></path>
                </svg>
                <a href={`mailto:${BIZ.email}`} class="text-[15px] hover:underline">{BIZ.email}</a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Get in Touch -->
  <section class="py-16 lg:py-24">
    <div class="wrap">
      <SectionTitle title="Get in Touch" kicker="Send Us a Message" class="mb-12" />
      <div class="mx-auto max-w-[770px]">
        <LeadForm client:visible />
      </div>
    </div>
  </section>
</Layout>
