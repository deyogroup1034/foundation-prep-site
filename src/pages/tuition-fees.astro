---
import Layout from '@/layouts/Layout.astro';
import PageTitle from '@/components/PageTitle.astro';
import { META } from '@/data/site';

const meta = META['tuition-fees'];

// The live page is a single embedded PDF with a download link beneath it.
const PDF = '/tuition-fees-summary-26-27.pdf';
---

<Layout title={meta.title} description={meta.description}>
  <PageTitle title="Tuition &amp; Fees" />
  <section class="py-14 lg:py-20">
    <div class="wrap">
      <div class="mx-auto max-w-[900px]">
        {/* <iframe> has no real "fallback content" semantics in HTML — unlike
            <object>, children are never rendered as a fallback, so the failure
            case is covered by the always-visible download button below
            instead, not by iframe children. */}
        <iframe src={PDF} title="Tuition &amp; fees summary PDF" class="h-[70vh] min-h-[520px] w-full border border-[#e2e4e7]" />

        <p class="mt-8 text-center">
          <a href={PDF} class="btn-brand" download>Click here to Download File</a>
        </p>
      </div>
    </div>
  </section>
</Layout>
